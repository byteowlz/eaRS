+int MoonshineStreamingModel::encode_audio(MoonshineStreamingState *state,
+                                          const float *audio, size_t audio_len,
+                                          bool is_final, size_t *consumed) {
+  if (consumed == nullptr) return 1;
+  *consumed = 0;
+  if (state == nullptr || (audio == nullptr && audio_len > 0) ||
+      config.frame_len <= 0) {
+    return 1;
+  }
+
+  // Keep the graph's two stride-2 convolutions aligned, including older
+  // frontend exports whose sample-remainder branch was traced away.
+  constexpr size_t kChunkSamples = 1280;
+  while (audio_len - *consumed >= kChunkSamples) {
+    const int err =
+        process_audio_chunk(state, audio + *consumed, kChunkSamples, nullptr);
+    if (err != 0) return err;
+    *consumed += kChunkSamples;
+  }
+
+  const size_t remainder = audio_len - *consumed;
+  if (is_final && remainder > 0) {
+    std::vector<float> final_chunk(kChunkSamples, 0.0f);
+    std::copy_n(audio + *consumed, remainder, final_chunk.begin());
+    const int previous_features = state->accumulated_feature_count;
+    const int64_t previous_frames = state->frame_count;
+    const int err =
+        process_audio_chunk(state, final_chunk.data(), kChunkSamples, nullptr);
+    if (err != 0) return err;
+
+    // Padding is only a frontend ABI accommodation. Keep every feature that
+    // contains real audio, but do not expose padding-only frames to attention.
+    const size_t samples_per_feature =
+        static_cast<size_t>(config.frame_len) * 4;
+    const size_t valid_features =
+        (remainder + samples_per_feature - 1) / samples_per_feature;
+    const size_t feature_count = previous_features + valid_features;
+    if (feature_count > static_cast<size_t>(state->accumulated_feature_count)) {
+      return 1;
+    }
+    state->accumulated_features.resize(feature_count * config.encoder_dim);
+    state->accumulated_feature_count = static_cast<int>(feature_count);
+    state->frame_count =
+        previous_frames + (remainder + config.frame_len - 1) / config.frame_len;
+    *consumed += remainder;
+  }
+
+  // Finalization can arrive without new audio after an aligned nonfinal
+  // update. It must still emit the encoder's held-back right context.
+  return encode(state, is_final, nullptr);
+}
