{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:byteowlz:device-scene:v1",
  "title": "Device scene v1: portable presentation snapshot",
  "$ref": "#/$defs/snapshot",
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100000,
        "maximum": 100000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "width",
        "height",
        "depth"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "z": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "ink",
        "emissive",
        "roughness",
        "metalness",
        "finish"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "emissive": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "finish": {
          "enum": [
            "matte",
            "brushed",
            "spun",
            "glass"
          ]
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "fov_y_deg",
        "yaw_deg",
        "pitch_deg",
        "target",
        "distance"
      ],
      "properties": {
        "projection": {
          "const": "perspective"
        },
        "fov_y_deg": {
          "type": "number",
          "minimum": 10,
          "maximum": 80
        },
        "yaw_deg": {
          "type": "number",
          "minimum": -60,
          "maximum": 60
        },
        "pitch_deg": {
          "type": "number",
          "minimum": -20,
          "maximum": 60
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "azimuth_deg",
        "elevation_deg",
        "intensity",
        "ambient"
      ],
      "properties": {
        "azimuth_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "ambient": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cols",
        "rows",
        "glyph_width",
        "glyph_height",
        "cell_width",
        "cell_height",
        "pitch",
        "padding_x",
        "padding_y"
      ],
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 160
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "glyph_width": {
          "const": 5
        },
        "glyph_height": {
          "enum": [
            7,
            8
          ]
        },
        "cell_width": {
          "const": 6
        },
        "cell_height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "padding_x": {
          "type": "number",
          "minimum": 0
        },
        "padding_y": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rect",
        "surface",
        "material",
        "label",
        "page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "surface": {
          "enum": [
            "faceplate",
            "module",
            "display"
          ]
        },
        "material": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "page": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "page",
        "kind",
        "rect",
        "material",
        "label",
        "accessible_name",
        "description",
        "tab_index",
        "action",
        "presentation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "page": {
          "type": "string",
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "button",
            "toggle",
            "knob",
            "fader",
            "select",
            "text",
            "shortcut",
            "meter",
            "indicator",
            "readout"
          ]
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "material": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "accessible_name": {
          "type": "string",
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "tab_index": {
          "type": "integer",
          "minimum": -1,
          "maximum": 4096
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "unit": {
          "type": "string",
          "maxLength": 4096
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
              },
              "label": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "maxItems": 128
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "max": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          }
        },
        "presentation": {
          "enum": [
            "native-text",
            "matrix",
            "printed",
            "none"
          ]
        },
        "matrix": {
          "$ref": "#/$defs/matrix"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "chassis",
        "panels",
        "controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "origin": {
          "$ref": "#/$defs/vec3"
        },
        "chassis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "depth",
            "front_thickness",
            "feet_height",
            "material",
            "vents"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "front_thickness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "feet_height": {
              "type": "number",
              "minimum": 0
            },
            "material": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "vents": {
              "type": "boolean"
            }
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          },
          "maxItems": 512
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          },
          "maxItems": 512
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "materials",
        "camera",
        "light",
        "devices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "materials": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/material"
          }
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "light": {
          "$ref": "#/$defs/light"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          },
          "maxItems": 8
        }
      }
    },
    "controlState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "enabled",
        "visible",
        "pressed",
        "focused",
        "busy",
        "error"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "pressed": {
          "type": "boolean"
        },
        "focused": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "maxLength": 4096
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "composing"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "composing": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "active_page",
        "controls"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_page": {
          "type": "string",
          "maxLength": 4096
        },
        "controls": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/controlState"
          }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_dip",
        "height_dip",
        "scale_factor",
        "pixel_cap",
        "transparent"
      ],
      "properties": {
        "width_dip": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "height_dip": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "pixel_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "transparent": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scene",
        "state",
        "viewport"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scene_id",
        "scene_revision",
        "state_revision",
        "control_id",
        "interaction_id",
        "sequence",
        "phase",
        "value",
        "source"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "scene_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "control_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "interaction_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "preview",
            "commit",
            "cancel"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source": {
          "enum": [
            "pointer",
            "keyboard",
            "accessibility",
            "api"
          ]
        }
      }
    }
  }
}
