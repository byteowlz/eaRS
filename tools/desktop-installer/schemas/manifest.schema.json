{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ears.desktop-payload/v1",
  "title": "eaRS unpacked desktop payload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "os", "arch", "version", "source_commit", "client_vad", "files"],
  "properties": {
    "schema": { "const": "ears.desktop-payload/v1" },
    "os": { "enum": ["linux", "windows", "macos"] },
    "arch": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_commit": { "type": "string", "minLength": 1, "maxLength": 256 },
    "client_vad": { "const": true },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "executable"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "executable": { "type": "boolean" }
        }
      }
    }
  },
  "$comment": "The executable validator additionally enforces host identity, portable ASCII paths, uniqueness, exact inventory and a 2 GiB aggregate byte bound. manifest.json is not in files."
}
